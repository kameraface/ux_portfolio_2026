# Copy to .env.local for local development. In GitHub, set these as repository variables
# (Settings → Secrets and variables → Actions → Variables) without the VITE_ prefix.

# SHA-256 hex of the shared case study password:
#   printf '%s' 'your-password' | shasum -a 256
VITE_CASE_STUDY_PASSWORD_HASH=

# Optional form endpoint (e.g. Formspree) that accepts JSON POSTs. Leave blank to fall back to mailto.
VITE_ACCESS_REQUEST_ENDPOINT=
